# SalesPilot AI Docker 部署环境变量模板
# 复制本文件为 .env，生成随机 Fernet 主密钥并修改密码后，使用 docker compose 部署

# ---- Web 入口 ----
WEB_BIND_HOST=0.0.0.0
WEB_PORT=4173
# 生产环境请填写真实访问域名，例如 https://salespilot.example.com
SALESPILOT_WEB_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SALESPILOT_SECURE_COOKIE=false

# ---- 模型密钥加密主密钥（必填：32 字节 urlsafe base64 Fernet Key） ----
# 生成命令：python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SALESPILOT_MODEL_CONFIG_KEY=REPLACE_WITH_FERNET_KEY
# 允许管理员填写的私有模型 / OCR / Rerank 网关白名单（逗号分隔）
SALESPILOT_MODEL_ALLOWED_BASE_URLS=

# ---- 轻量单机版 / 初始化管理员账号（密码长度 12~256 位） ----
SALESPILOT_RAG_MODE=demo
SALESPILOT_DEMO_PASSWORD_A=change-me-admin-password-1234
SALESPILOT_DEMO_PASSWORD_B=change-me-sales-password-5678

# ---- 企业全栈版（docker-compose.enterprise.yml）专属配置 ----
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=change-me-pg-password-1234
POSTGRES_DB=salespilot_rag
MINIO_ROOT_USER=salespilot-minio
MINIO_ROOT_PASSWORD=change-me-minio-password-1234
SALESPILOT_S3_BUCKET=salespilot-docs
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-kc-password-1234
SALESPILOT_OIDC_ISSUER=http://keycloak:8080/realms/salespilot
SALESPILOT_OIDC_AUDIENCE=salespilot-web
SALESPILOT_OIDC_DEFAULT_ORG=
